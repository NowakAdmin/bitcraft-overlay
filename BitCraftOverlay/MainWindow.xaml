<Window x:Class="BitCraftOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BitCraft Overlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#1E1E1E"
        Foreground="White"
        Width="420" Height="680">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CalcLabel">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
        <!-- Same fix as HeaderWindow: the default Windows button template ignores
             Foreground for its text in some themes (renders black regardless). -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClaimGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="ClaimGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="Browser" Grid.Column="0"/>

        <!-- Native rate calculator - not a browser tab, so it swaps in for the WebView2
             in this same cell instead of navigating anywhere. -->
        <Grid x:Name="CalcPanel" Grid.Column="0" Background="#1E1E1E" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="8">
                <TextBlock Text="START" FontSize="10" FontWeight="Bold" Opacity="0.8"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Now" Width="36" Padding="0,3" FontSize="10" Click="CalcStartNow_Click"/>
                    <TextBox x:Name="CalcStartTimeBox" Grid.Column="1" Margin="4,0,0,0" TextChanged="CalcField_Changed"/>
                </Grid>
                <TextBlock Text="VALUE" Style="{StaticResource CalcLabel}"/>
                <TextBox x:Name="CalcStartValueBox" TextChanged="CalcField_Changed"/>

                <TextBlock Text="STOP" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,10,0,0"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Now" Width="36" Padding="0,3" FontSize="10" Click="CalcStopNow_Click"/>
                    <TextBox x:Name="CalcStopTimeBox" Grid.Column="1" Margin="4,0,0,0" TextChanged="CalcField_Changed"/>
                </Grid>
                <TextBlock Text="VALUE" Style="{StaticResource CalcLabel}"/>
                <TextBox x:Name="CalcStopValueBox" TextChanged="CalcField_Changed"/>

                <TextBlock x:Name="CalcRateLabel" Text="—" FontSize="14" FontWeight="Bold" Margin="0,10,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CalcNameBox" Width="100"/>
                    <Button Content="Save" Margin="4,0,0,0" Padding="8,3" Click="CalcSave_Click"/>
                    <Button Content="🗑" Margin="4,0,0,0" Padding="6,3" Click="CalcDelete_Click"
                            ToolTip="Delete the selected saved calculation"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="#242424" BorderThickness="1,0,0,0" BorderBrush="#333">
                <ListBox x:Name="CalcHistoryList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="CalcHistory_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,3">
                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RateDisplay}" FontSize="9" Foreground="White" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Player-stats snapshots from bitjita.com's API - also native, also swaps in
             for the WebView2 instead of navigating anywhere. -->
        <ScrollViewer x:Name="StatsPanel" Grid.Column="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock Text="PLAYER" FontSize="10" FontWeight="Bold" Opacity="0.8"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StatsPlayerNameBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="Find" Margin="4,0,0,0" Click="StatsFindPlayer_Click"/>
                </Grid>
                <TextBlock x:Name="StatsPlayerFoundLabel" Style="{StaticResource CalcLabel}"/>

                <TextBlock Text="SNAPSHOT COMPARE" FontSize="10" FontWeight="Bold" Opacity="0.8" Margin="0,12,0,0"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Take A" Click="StatsTakeA_Click"/>
                    <Button Grid.Column="1" Content="Take B" Margin="4,0,0,0" Click="StatsTakeB_Click"/>
                </Grid>
                <TextBlock x:Name="StatsAbLabel" Text="A: not taken   B: not taken" Style="{StaticResource CalcLabel}"/>

                <ItemsControl x:Name="StatsDiffList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" Foreground="White" TextWrapping="Wrap" Margin="0,1,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StatsCompareNameBox" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="Save" Margin="4,0,0,0" Click="StatsSaveComparison_Click"/>
                </Grid>

                <ItemsControl x:Name="StatsComparisonHistoryList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#242424" Margin="0,2,0,0" Padding="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="10" Foreground="White"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" Content="Load" Padding="6,1" FontSize="9"
                                            Click="StatsLoadComparison_Click" Tag="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Claim/settlement lookup from bitjita.com's API - also native, also swaps in
             for the WebView2 instead of navigating anywhere. -->
        <Grid x:Name="ClaimPanel" Grid.Column="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,8,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ClaimNameBox" Grid.Column="0"/>
                <Button Grid.Column="1" Content="Find" Margin="4,0,0,0" Click="ClaimFind_Click"/>
            </Grid>
            <TextBlock x:Name="ClaimFoundLabel" Grid.Row="1" Style="{StaticResource CalcLabel}" Margin="8,2,8,0"/>

            <Grid Grid.Row="2" Margin="8,10,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ClaimSubTabMembers" Grid.Column="0" Content="Members" Click="ClaimSubTab_Click"/>
                <Button x:Name="ClaimSubTabArmor" Grid.Column="1" Content="Armor" Margin="4,0,0,0" Click="ClaimSubTab_Click"/>
                <Button x:Name="ClaimSubTabTools" Grid.Column="2" Content="Tools" Margin="4,0,0,0" Click="ClaimSubTab_Click"/>
            </Grid>

            <Grid Grid.Row="3">
                <!-- Sub-tab 1: members table - Name + one column per skill (built in code-behind,
                     since the skill set comes from the API), cell background = level's tier color.
                     Headers are clickable text (see code-behind) rather than the DataGrid's built-in
                     sort click, which didn't reliably fire for the dynamically-built skill columns. -->
                <DataGrid x:Name="ClaimMembersGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          IsReadOnly="True" GridLinesVisibility="None" RowHeight="22" FontSize="10"
                          Background="#1E1E1E" Foreground="White" BorderThickness="0"
                          RowBackground="#242424" AlternatingRowBackground="#2A2A2A" FrozenColumnCount="1"
                          ColumnHeaderStyle="{StaticResource ClaimGridHeaderStyle}" CellStyle="{StaticResource ClaimGridCellStyle}"
                          PreviewMouseLeftButtonUp="ClaimMembersGrid_HeaderClicked"/>

                <!-- Sub-tab 2: every member's armor, one row per saved preset (up to 3) -->
                <DataGrid x:Name="ClaimArmorGrid" Visibility="Collapsed" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          IsReadOnly="True" GridLinesVisibility="None" RowHeight="22" FontSize="10"
                          Background="#1E1E1E" Foreground="White" BorderThickness="0"
                          RowBackground="#242424" AlternatingRowBackground="#2A2A2A" FrozenColumnCount="2"
                          ColumnHeaderStyle="{StaticResource ClaimGridHeaderStyle}" CellStyle="{StaticResource ClaimGridCellStyle}"
                          PreviewMouseLeftButtonUp="ClaimArmorGrid_HeaderClicked"/>

                <!-- Sub-tab 3: one row per member, each skill cell stacking up to 3 lines
                     (Tool/Instrument/Charm) - no fixed RowHeight, so rows auto-size to fit. -->
                <DataGrid x:Name="ClaimToolsGrid" Visibility="Collapsed" AutoGenerateColumns="False" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          IsReadOnly="True" GridLinesVisibility="None" FontSize="10"
                          Background="#1E1E1E" Foreground="White" BorderThickness="0"
                          RowBackground="#242424" AlternatingRowBackground="#2A2A2A" FrozenColumnCount="2"
                          ColumnHeaderStyle="{StaticResource ClaimGridHeaderStyle}" CellStyle="{StaticResource ClaimGridCellStyle}"
                          PreviewMouseLeftButtonUp="ClaimToolsGrid_HeaderClicked"/>
            </Grid>
        </Grid>

        <!-- Reserved strip: kept in its own column so it never sits under the WebView2
             HWND, which would otherwise eat the mouse input (airspace issue). Only the
             grip glyph at the bottom is interactive; drag it to resize width + height. -->
        <Grid Grid.Column="1" Background="#1E1E1E">
            <TextBlock Text="◢" FontSize="14" Foreground="#666666"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,1"
                       Cursor="SizeNWSE"
                       MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                       MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                       MouseMove="ResizeGrip_MouseMove"/>
        </Grid>
    </Grid>
</Window>
