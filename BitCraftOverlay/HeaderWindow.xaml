<Window x:Class="BitCraftOverlay.HeaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#2D2D2D"
        Foreground="White"
        Height="28" Width="420">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <!-- Always fully opaque, regardless of the content window's transparency setting,
         so the user can never slider their way into losing access to these controls. -->
    <Grid Background="Transparent"
          MouseLeftButtonDown="Header_MouseLeftButtonDown"
          MouseLeftButtonUp="Header_MouseLeftButtonUp"
          MouseMove="Header_MouseMove">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="TabBitcraftSync" Content="BitcraftSync" Padding="8,0" Height="28" Click="Tab_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button x:Name="TabBitjita" Content="Bitjita" Padding="8,0" Height="28" Click="Tab_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button x:Name="TabBrico" Content="Brico" Padding="8,0" Height="28" Click="Tab_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button x:Name="TabMapa" Content="Mapa" Padding="8,0" Height="28" Click="Tab_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="Twitch" Padding="8,0" Height="28" Margin="4,0,0,0" Click="Twitch_Click"
                    ToolTip="Otwórz twitch.tv/bitcraftonline w osobnym oknie (obejrzyj stream, zbieraj dropy)"
                    Background="#9146FF" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="▭" Width="28" Height="28" Click="ResetSize_Click" ToolTip="Przywróć domyślny rozmiar"
                    Background="Transparent" Foreground="White" BorderThickness="0" FontSize="11"/>
            <Button Content="–" Width="28" Height="28" Click="Minimize_Click" ToolTip="Zwiń"
                    Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16"/>
            <Button Content="⚙" Width="28" Height="28" Click="Settings_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
            <Button Content="✕" Width="28" Height="28" Click="Close_Click"
                    Background="Transparent" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
