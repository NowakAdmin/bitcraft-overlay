<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.4.0</Version>
    <!-- Self-contained single-file publish still leaves native (non-.NET) libraries like
         WebView2Loader.dll as loose files alongside the exe unless this is set - it makes them
         self-extract to a per-version temp cache at first run instead, so the self-contained
         release asset really is "just the one .exe" as the README promises. Only affects
         single-file publishes; no effect on normal dotnet build/run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Company>Nowak Administrators Sp. z o.o.</Company>
    <Authors>Nowak Administrators Sp. z o.o.</Authors>
    <Product>BitCraft Overlay</Product>
    <Copyright>Copyright © Nowak Administrators Sp. z o.o.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icons\*.ico" />
    <Resource Include="Assets\icons\*.png" />
  </ItemGroup>

</Project>
