<Window x:Class="BitCraftOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ustawienia BitCraft Overlay"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Wklej pełny link udostępniania z bitcraftsync.app (np. https://bitcraftsync.app/s/twoj-kod) - sam kod też zadziała:" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox x:Name="ShareCodeBox" Padding="4"/>

        <TextBlock Text="Przezroczystość nakładki (pasek zakładek zawsze zostaje w pełni widoczny):" TextWrapping="Wrap" Margin="0,16,0,4"/>
        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="90" TickFrequency="10" IsSnapToTickEnabled="True"
                ValueChanged="TransparencySlider_ValueChanged"/>
        <TextBlock x:Name="TransparencyLabel" HorizontalAlignment="Right" FontSize="10" Opacity="0.7" Margin="0,2,0,0"/>

        <TextBlock Text="Widoczne zakładki:" Margin="0,16,0,4"/>
        <WrapPanel>
            <CheckBox x:Name="ShowBitcraftSync" Content="BitcraftSync" Margin="0,0,12,4"/>
            <CheckBox x:Name="ShowBitjita" Content="Bitjita" Margin="0,0,12,4"/>
            <CheckBox x:Name="ShowBrico" Content="Brico" Margin="0,0,12,4"/>
            <CheckBox x:Name="ShowMapa" Content="Mapa" Margin="0,0,12,4"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock x:Name="VersionLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
            <Button x:Name="CheckUpdateButton" Content="Sprawdź aktualizacje" Padding="8,2" Margin="10,0,0,0" Click="CheckUpdate_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Anuluj" Padding="10,4" Click="Cancel_Click" Margin="0,0,6,0"/>
            <Button Content="Zapisz" Padding="10,4" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
