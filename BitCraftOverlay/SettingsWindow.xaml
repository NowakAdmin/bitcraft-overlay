<Window x:Class="BitCraftOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitCraft Overlay Settings"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="NoResize">
    <Window.Resources>
        <!-- Discord-style animated on/off switch, built on ToggleButton so IsChecked
             works exactly like a CheckBox did - no code-behind changes needed. -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush x:Name="TrackColor" Color="#4F545C"/>
                            </Border.Background>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackColor" Storyboard.TargetProperty="Color" To="#3BA55D" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="TrackColor" Storyboard.TargetProperty="Color" To="#4F545C" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToggleRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="Paste your full bitcraftsync.app share link (e.g. https://bitcraftsync.app/s/your-code) - the bare code works too:" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox x:Name="ShareCodeBox" Padding="4"/>

        <TextBlock Text="Tab bar style:" Margin="0,16,0,6"/>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="UseIconsToggle" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Show icons instead of text labels" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TextBlock Text="Visible tabs:" Margin="0,16,0,6"/>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowBitcraftSync" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="BitcraftSync" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowBitjita" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Bitjita" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowBrico" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Brico" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowMapa" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Map" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowCalc" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Calc" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowStats" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Stats" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowClaim" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Claim" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Style="{StaticResource ToggleRow}">
            <ToggleButton x:Name="ShowTwitch" Style="{StaticResource ToggleSwitch}"/>
            <TextBlock Text="Twitch" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <Button Content="☕ Support on Ko-fi" Padding="8,4" Margin="0,16,0,0" HorizontalAlignment="Left"
                Background="#72A4F2" Foreground="White" BorderThickness="0" Click="Kofi_Click"/>

        <Button Content="Open saved data folder" Padding="8,4" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenDataFolder_Click"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="VersionLabel" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
            <Button x:Name="CheckUpdateButton" Content="Check for updates" Padding="8,2" Margin="10,0,0,0" Click="CheckUpdate_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="10,4" Click="Cancel_Click" Margin="0,0,6,0"/>
            <Button Content="Save" Padding="10,4" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
