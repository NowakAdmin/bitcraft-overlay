<!-- Route tab's map + setup panel, in its own window - separate from MainWindow
     because MainWindow hosts the WebView2 browser control for every other tab, and
     WebView2 is incompatible with AllowsTransparency="True" (confirmed empirically:
     the whole window renders blank white, regardless of opacity/click-through
     settings). This window has no WebView2, so it can safely support real
     window-level click-through + opacity. Positioned/sized to exactly track
     MainWindow's own client area (minus its resize-grip strip) - see MainWindow's
     Loaded handler and the LocationChanged/SizeChanged hooks alongside HeaderWindow's. -->
<Window x:Class="BitCraftOverlay.RouteOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="#1E1E1E"
        Foreground="White">
    <Window.Resources>
        <!-- Same styles as MainWindow.xaml.Resources - duplicated rather than shared,
             this window's only content is the Route panel that used to live there. -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="CalcLabel">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="0,4,0,1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RouteRoot" Background="#1E1E1E">
        <Image x:Name="RouteMapImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <TextBlock x:Name="RouteMapPlaceholder" Text="Compute a route to see the map here"
                   Foreground="White" Opacity="0.4" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"/>

        <Border x:Name="RouteSetupPanel" Background="#DD1E1E1E" CornerRadius="4" Padding="8"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" MaxWidth="210" BorderThickness="1" BorderBrush="#444">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ROUTE SETUP" FontSize="9" FontWeight="Bold" Opacity="0.8" VerticalAlignment="Center"/>
                    <Button x:Name="RouteToggleSetupButton" Grid.Column="1" Content="–" Width="18" Height="18" Padding="0" FontSize="11"
                            Background="#3A3A3A" Foreground="White" BorderThickness="0" Click="RouteToggleSetup_Click"/>
                </Grid>
                <StackPanel x:Name="RouteSetupBody" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RoutePlayerNameBox" Grid.Column="0" FontSize="11"/>
                        <Button Grid.Column="1" Content="Find" Margin="4,0,0,0" Padding="6,2" Click="RouteFindPlayer_Click"/>
                    </Grid>
                    <ListBox x:Name="RoutePlayerResultsList" Margin="0,2,0,0" MaxHeight="90" FontSize="11"
                             Visibility="Collapsed" SelectionChanged="RoutePlayerResultsList_SelectionChanged"
                             DisplayMemberPath="Username"/>
                    <TextBlock x:Name="RoutePlayerFoundLabel" Style="{StaticResource CalcLabel}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                    <ComboBox x:Name="RouteResourceCombo" Margin="0,8,0,0" FontSize="11"
                              IsTextSearchEnabled="True" TextSearch.TextPath="Name" DisplayMemberPath="Name"
                              SelectionChanged="RouteResourceCombo_SelectionChanged"/>

                    <CheckBox x:Name="RouteAllowWaterCheck" Content="Allow crossing water (fishing)" Foreground="White" FontSize="11" Margin="0,8,0,0"
                              Checked="RouteAllowWaterCheck_Changed" Unchecked="RouteAllowWaterCheck_Changed"/>

                    <CheckBox x:Name="RouteUseInGameMapCheck" Content="Use in-game map" Foreground="White" FontSize="11" Margin="0,4,0,0"
                              ToolTip="Draws only the route line/node dots on a transparent background, framed on your own position - position this window over BitCraft's own minimap instead of showing our own map. Pair with Click-through (Settings) so clicks still reach the minimap."
                              Checked="RouteUseInGameMapCheck_Changed" Unchecked="RouteUseInGameMapCheck_Changed"/>

                    <CheckBox x:Name="RouteShowExtraNodesCheck" Content="Display extra resources" Foreground="White" FontSize="11" Margin="0,4,0,0"
                              ToolTip="Show dim dots for every nearby matching resource beyond what's actually routed through - turn off if a dense area gets too cluttered."
                              Checked="RouteShowExtraNodesCheck_Changed" Unchecked="RouteShowExtraNodesCheck_Changed"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Zoom" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="−" Width="22" Padding="0" Margin="4,0,0,0" Click="RouteZoomOut_Click"/>
                        <TextBlock x:Name="RouteZoomLabel" Grid.Column="2" Text="100%" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Width="22" Padding="0" Click="RouteZoomIn_Click"/>
                    </Grid>

                    <TextBlock x:Name="RouteStatusLabel" Style="{StaticResource CalcLabel}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MainWindow itself is hidden while this window is showing (see MainWindow.ShowTab),
             so its own resize grip is unreachable - this is the equivalent for the Route tab. -->
        <TextBlock x:Name="RouteResizeGrip" Text="◢" FontSize="14" Foreground="#666666"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1"
                   Cursor="SizeNWSE"
                   MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                   MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                   MouseMove="ResizeGrip_MouseMove"/>
    </Grid>
</Window>
